
/* =================================
   RECOVERYX PRIVATE
   DARK CHARCOAL + NEON CYAN THEME
================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --background: #080c15;
    --sidebar: #0b111d;
    --card: #1b222e;
    --card-light: #222c39;
    --border: #354653;
    --cyan: #20d8d0;
    --light-cyan: #83f4f2;
    --white: #edf7ff;
    --muted: #91a7b7;
}

/* GLOBAL */

html {
    scroll-behavior: smooth;
}

body {
    min-height: 100vh;
    font-family: Arial, Helvetica, sans-serif;
    color: var(--white);

    background:
        radial-gradient(
            circle at 75% 15%,
            #12414b 0%,
            transparent 38%
        ),
        linear-gradient(
            135deg,
            #050912,
            #101b29,
            #07121e
        );
}

/* APP LAYOUT */

.app {
    display: flex;
    min-height: 100vh;
}

/* =================================
   SIDEBAR MENU
================================= */

.sidebar {
    width: 270px;
    min-width: 270px;
    padding: 25px 20px;

    display: flex;
    flex-direction: column;

    background: linear-gradient(
        180deg,
        #080e19,
        #111c2a
    );

    border-right: 1px solid #20d8d044;

    box-shadow: 5px 0 25px #0008;
}

.menu-title {
    color: var(--light-cyan);
    font-size: 23px;
    letter-spacing: 2px;

    margin: 15px 5px 30px;

    text-shadow: 0 0 12px #20d8d0;
}

.sidebar nav {
    display: flex;
    flex-direction: column;
    gap: 13px;
}

.menu-item {
    display: block;
    width: 100%;

    padding: 18px 12px;

    text-align: center;
    text-decoration: none;

    color: #c4d6e2;
    font-size: 15px;
    font-weight: bold;
    letter-spacing: 1px;

    border: 1px solid #40505d;
    border-radius: 40px;

    background: linear-gradient(
        135deg,
        #202936,
        #111a26
    );

    box-shadow: inset 0 0 10px #0005;

    transition: 0.25s ease;
}

.menu-item:hover,
.menu-item.active {
    color: var(--cyan);
    border-color: var(--cyan);

    background: linear-gradient(
        135deg,
        #17343c,
        #202d3a
    );

    box-shadow:
        0 0 15px #20d8d055,
        inset 0 0 10px #20d8d022;

    transform: translateX(3px);
}

/* SIDEBAR FOOTER */

.side-footer {
    margin-top: auto;
    padding-top: 55px;

    text-align: center;

    color: #a8bdc9;
    font-size: 12px;
    line-height: 2;
}

.side-footer span {
    display: block;
    font-size: 42px;
    margin-bottom: 8px;
}

.side-footer p {
    color: var(--cyan);
    font-weight: bold;
    letter-spacing: 1px;
}

/* =================================
   MAIN CONTENT
================================= */

.main-content {
    flex: 1;
    min-width: 0;

    width: 100%;
    max-width: 1400px;

    margin: 0 auto;
    padding: 28px;

    background:
        radial-gradient(
            ellipse at 85% 10%,
            #16bfff18,
            transparent 45%
        );
}

/* HEADER */

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;

    gap: 15px;
    margin-bottom: 28px;
}

.header h1 {
    color: var(--cyan);
    font-size: 30px;
    letter-spacing: 2px;

    text-shadow: 0 0 15px #20d8d077;
}

.header h1 span {
    color: var(--light-cyan);
}

.header p {
    margin-top: 8px;

    color: var(--muted);
    font-size: 12px;
    letter-spacing: 2px;
}

.switch-label {
    color: var(--cyan);
    font-size: 13px;
    font-weight: bold;
    white-space: nowrap;
}

.online-dot,
.result-dot {
    display: inline-block;

    width: 9px;
    height: 9px;

    margin-right: 7px;

    border-radius: 50%;
    background: #31e9a0;

    box-shadow: 0 0 10px #31e9a0;
}

/* =================================
   PANELS
================================= */

.panel {
    padding: 27px;
    margin-bottom: 24px;

    background: linear-gradient(
        145deg,
        #202633,
        #171d29
    );

    border: 1px solid var(--border);
    border-radius: 22px;

    box-shadow:
        0 10px 30px #0007,
        inset 0 1px 1px #ffffff08;

    transition: 0.25s ease;
}

.panel:hover {
    border-color: #20d8d066;
}

.panel-title {
    margin-bottom: 25px;

    color: var(--cyan);
    font-size: 20px;
    font-weight: bold;
    letter-spacing: 1.5px;

    text-shadow: 0 0 10px #20d8d044;
}

/* =================================
   FORM GRID
================================= */

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
}

.field {
    margin-top: 24px;
}

.field label {
    display: block;

    margin-bottom: 10px;

    color: var(--light-cyan);
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1.5px;
}

/* INPUTS AND SELECTS */

input,
select {
    width: 100%;
    min-width: 0;

    padding: 17px;

    color: var(--white);
    font-size: 15px;

    background: #111a26;

    border: 1px solid #40515f;
    border-radius: 13px;

    outline: none;

    transition: 0.25s ease;
}

input::placeholder {
    color: #758b9c;
}

input:focus,
select:focus {
    border-color: var(--cyan);

    box-shadow:
        0 0 0 2px #20d8d022,
        0 0 14px #20d8d044;
}

select option {
    color: white;
    background: #111a26;
}

/* =================================
   SUBMIT BUTTON
================================= */

.submit-btn {
    width: 100%;

    margin-top: 25px;
    padding: 19px;

    color: var(--cyan);
    font-size: 18px;
    font-weight: bold;
    letter-spacing: 2px;

    background: linear-gradient(
        110deg,
        #172532,
        #263443
    );

    border: 2px solid var(--cyan);
    border-radius: 18px;

    cursor: pointer;

    box-shadow: 0 0 15px #20d8d033;

    transition: 0.25s ease;
}

.submit-btn:hover {
    color: #061b23;

    background: linear-gradient(
        110deg,
        #20d8d0,
        #83f4f2
    );

    box-shadow: 0 0 22px #20d8d077;
}

.submit-btn:active {
    transform: scale(0.98);
}

/* RESULT */

.result {
    margin-top: 23px;
    padding: 16px;

    color: #b9d4df;
    font-size: 13px;

    background: #111925;

    border: 1px solid #354653;
    border-radius: 12px;
}

.result-dot {
    background: var(--cyan);
    box-shadow: 0 0 10px var(--cyan);
}

/* REFERENCE */

.reference {
    margin-top: 32px;
}

.reference h3 {
    color: var(--white);
    font-size: 22px;
    letter-spacing: 2px;
}

.reference p {
    margin-top: 7px;

    color: var(--muted);
    font-size: 12px;
}

/* =================================
   STATUS ROWS
================================= */

.status-row {
    display: flex;
    justify-content: space-between;
    align-items: center;

    gap: 15px;
    padding: 17px 5px;

    color: #c4d6e2;

    border-bottom: 1px solid #344653;
}

.status-row strong {
    color: var(--cyan);
    font-size: 12px;
    text-align: right;
    letter-spacing: 1px;
}

/* =================================
   OFFICIAL TOOL LINKS
================================= */

.tool-link {
    display: block;

    padding: 17px;
    margin-bottom: 13px;

    color: var(--cyan);
    font-size: 14px;
    font-weight: bold;
    text-decoration: none;
    letter-spacing: 1px;

    background: #151e2b;

    border: 1px solid #40515f;
    border-radius: 13px;

    transition: 0.25s ease;
}

.tool-link:hover {
    color: var(--light-cyan);
    border-color: var(--cyan);

    box-shadow: 0 0 13px #20d8d044;

    transform: translateX(3px);
}

/* =================================
   NOTICE PANEL
================================= */

.notice-content {
    margin-top: 22px;
    padding: 20px;

    background: #111925;

    border: 1px solid #354653;
    border-left: 4px solid var(--cyan);

    border-radius: 12px;
}

.notice-content h3 {
    margin-bottom: 15px;

    color: var(--cyan);
    font-size: 15px;
    letter-spacing: 1px;
}

.notice-content p {
    margin-bottom: 12px;

    color: #c0d1dd;
    font-size: 14px;
    line-height: 1.7;
}

/* =================================
   FOOTER
================================= */

footer {
    padding: 25px 10px;

    color: #91a7b7;
    font-size: 12px;
    line-height: 2;

    text-align: center;
}

/* =================================
   TABLET
================================= */

@media (max-width: 950px) {

    .sidebar {
        width: 230px;
        min-width: 230px;
        padding: 20px 14px;
    }

    .main-content {
        padding: 20px;
    }

    .panel {
        padding: 22px;
    }
}

/* =================================
   MOBILE
================================= */

@media (max-width: 700px) {

    .app {
        flex-direction: column;
    }

    .sidebar {
        width: 100%;
        min-width: 0;

        padding: 15px;

        border-right: none;
        border-bottom: 1px solid var(--cyan);
    }

    .menu-title {
        margin: 5px 5px 17px;
        font-size: 20px;
    }

    .sidebar nav {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 9px;
    }

    .menu-item {
        padding: 14px 7px;
        font-size: 13px;
    }

    .side-footer {
        display: none;
    }

    .main-content {
        padding: 14px;
    }

    .header {
        align-items: flex-start;
        flex-direction: column;
    }

    .header h1 {
        font-size: 25px;
    }

    .panel {
        padding: 18px;
        border-radius: 17px;
    }

    .panel-title {
        font-size: 17px;
        margin-bottom: 20px;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    input,
    select {
        padding: 15px;
    }

    .submit-btn {
        padding: 17px;
        font-size: 16px;
    }

    .status-row {
        font-size: 13px;
    }

    .notice-content {
        padding: 15px;
    }
}

/* SMALL MOBILE */

@media (max-width: 360px) {

    .sidebar nav {
        grid-template-columns: 1fr;
    }

    .header h1 {
        font-size: 22px;
    }

    .status-row {
        align-items: flex-start;
        flex-direction: column;
    }
}
