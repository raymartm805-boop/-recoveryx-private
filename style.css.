:root {
    --background: #080d16;
    --sidebar: #0c1421;
    --panel: #111d2b;
    --panel-light: #172536;
    --border: #263b4c;
    --cyan: #20e0d0;
    --cyan-light: #8afff5;
    --text: #edf7fa;
    --muted: #8498a9;
    --green: #40e6a0;
    --red: #ff7777;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
}

body {
    min-height: 100vh;
    background:
        radial-gradient(circle at 80% 0%, #102d3a 0%, transparent 30%),
        var(--background);
    color: var(--text);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 14px;
}

button,
input,
select {
    font: inherit;
}

a {
    color: inherit;
    text-decoration: none;
}

.app {
    min-height: 100vh;
}

/* SIDEBAR */

.sidebar {
    width: 260px;
    height: 100vh;
    position: fixed;
    left: 0;
    top: 0;
    z-index: 100;
    background: var(--sidebar);
    border-right: 1px solid var(--border);
    padding: 28px 18px;
    display: flex;
    flex-direction: column;
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 7px 35px;
}

.brand-icon {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    color: var(--cyan);
    font-size: 17px;
    font-weight: 900;
    border: 2px solid var(--cyan);
    border-radius: 12px;
    box-shadow: 0 0 18px #20e0d033;
}

.brand h2 {
    font-size: 17px;
    letter-spacing: 1px;
}

.brand h2 span {
    color: var(--cyan);
}

.brand small {
    display: block;
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 2px;
    margin-top: 5px;
}

.menu-label {
    padding: 10px 12px;
    color: var(--muted);
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 2px;
}

.navigation {
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.nav-link {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 14px;
    border-radius: 9px;
    color: #a6b7c5;
    font-size: 13px;
    transition: 0.2s ease;
}

.nav-link span {
    width: 20px;
    text-align: center;
    font-size: 17px;
}

.nav-link:hover,
.nav-link.active {
    background: #16303a;
    color: var(--cyan);
    border-left: 3px solid var(--cyan);
}

.sidebar-bottom {
    margin-top: auto;
    padding: 15px 10px;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 1px;
}

.online-dot {
    width: 8px;
    height: 8px;
    background: var(--green);
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 10px #40e6a088;
    flex-shrink: 0;
}

/* MAIN */

.main-content {
    margin-left: 260px;
    padding: 0 35px 30px;
    max-width: 1800px;
}

.topbar {
    min-height: 85px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
    margin-bottom: 35px;
    gap: 15px;
}

.top-title {
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 2px;
}

.top-subtitle {
    margin-top: 6px;
    font-size: 11px;
    color: var(--muted);
}

.top-status {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: 30px;
    color: var(--cyan);
    font-size: 10px;
    font-weight: bold;
}

.menu-toggle {
    display: none;
    background: transparent;
    color: var(--cyan);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 9px 12px;
    cursor: pointer;
}

/* WELCOME */

.welcome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
}

.eyebrow {
    color: var(--cyan);
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 2px;
    margin-bottom: 12px;
}

.welcome h1 {
    font-size: clamp(25px, 4vw, 35px);
    margin-bottom: 10px;
}

.welcome h1 span {
    color: var(--cyan);
}

.welcome p,
.section-heading p {
    color: var(--muted);
    line-height: 1.6;
}

.system-badge,
.card-tag {
    border: 1px solid var(--border);
    color: var(--cyan);
    border-radius: 7px;
    padding: 10px 13px;
    font-size: 10px;
    white-space: nowrap;
}

.system-badge {
    display: flex;
    align-items: center;
    gap: 8px;
}

/* STAT CARDS */

.stats-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-bottom: 25px;
}

.stat-card {
    background: linear-gradient(145deg, var(--panel-light), var(--panel));
    border: 1px solid var(--border);
    border-radius: 13px;
    padding: 22px;
    min-width: 0;
}

.stat-icon {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 9px;
    margin-bottom: 20px;
    font-size: 19px;
}

.cyan {
    color: var(--cyan);
    background: #20e0d018;
}

.blue {
    color: #65aaff;
    background: #65aaff18;
}

.purple {
    color: #bd9cff;
    background: #bd9cff18;
}

.stat-label {
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 1.5px;
    margin-bottom: 8px;
}

.stat-value {
    font-size: 17px;
    font-weight: bold;
    overflow-wrap: anywhere;
}

.stat-note {
    color: var(--muted);
    font-size: 11px;
    margin-top: 8px;
}

/* CONTENT CARDS */

.content-card {
    background: linear-gradient(145deg, #121f2e, #0e1926);
    border: 1px solid var(--border);
    border-radius: 13px;
    padding: 25px;
    margin-bottom: 22px;
    scroll-margin-top: 25px;
}

.section-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 25px;
}

.section-heading h2,
.content-card h2 {
    font-size: 19px;
    margin-bottom: 9px;
}

.section-heading p {
    font-size: 12px;
}

/* FORM */

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 9px;
    min-width: 0;
}

.full-width {
    grid-column: 1 / -1;
}

.form-group label {
    color: #a8bbc9;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1px;
}

.form-group input,
.form-group select {
    width: 100%;
    min-height: 47px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: #09131f;
    color: var(--text);
    outline: none;
}

.form-group input:focus,
.form-group select:focus {
    border-color: var(--cyan);
    box-shadow: 0 0 0 3px #20e0d018;
}

.primary-button {
    margin-top: 23px;
    min-height: 48px;
    padding: 0 20px;
    background: var(--cyan);
    border: 1px solid var(--cyan);
    border-radius: 8px;
    color: #061316;
    font-weight: bold;
    cursor: pointer;
    transition: 0.2s;
}

.primary-button span {
    margin-left: 12px;
    font-size: 17px;
}

.primary-button:hover {
    background: var(--cyan-light);
    box-shadow: 0 0 20px #20e0d044;
    transform: translateY(-2px);
}

.result-box {
    margin-top: 22px;
    padding: 17px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: #09131f;
    line-height: 1.6;
}

.result-heading {
    color: var(--cyan);
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1.5px;
    margin-bottom: 7px;
}

/* STATUS */

.status-list {
    display: flex;
    flex-direction: column;
}

.status-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    padding: 17px 0;
    border-bottom: 1px solid var(--border);
    font-size: 12px;
}

.status-row:last-child {
    border-bottom: none;
}

.status-row > span {
    color: #b9c9d4;
}

.status-row strong {
    font-size: 10px;
    text-align: right;
}

.status-online {
    color: var(--green);
}

.status-offline {
    color: #ffad78;
}

/* TOOLS */

.tools-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 15px;
}

.tool-card {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    background: #0a1521;
    border: 1px solid var(--border);
    padding: 17px;
    border-radius: 10px;
    transition: 0.2s;
}

.tool-card:hover {
    border-color: var(--cyan);
    transform: translateY(-3px);
}

.tool-icon {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 9px;
    background: #20e0d018;
    color: var(--cyan);
    font-size: 20px;
    font-weight: bold;
}

.tool-icon.instagram {
    color: #e69bce;
    background: #e69bce18;
}

.tool-icon.tiktok {
    color: #8ff5ed;
    background: #8ff5ed18;
}

.tool-card h3 {
    font-size: 12px;
    margin-bottom: 5px;
}

.tool-card p {
    color: var(--muted);
    font-size: 10px;
    line-height: 1.5;
}

.tool-card > span {
    color: var(--cyan);
    margin-left: auto;
}

/* NOTICE */

.notice-card p {
    color: #aabac6;
    font-size: 12px;
    line-height: 1.8;
    margin-top: 13px;
}

.notice-warning {
    color: #ffbd82 !important;
}

/* FOOTER */

.footer {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding: 25px 5px;
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 1px;
}

/* TABLET */

@media (max-width: 1100px) {

    .sidebar {
        width: 225px;
    }

    .main-content {
        margin-left: 225px;
        padding-left: 23px;
        padding-right: 23px;
    }

    .tools-grid {
        grid-template-columns: 1fr;
    }
}

/* MOBILE */

@media (max-width: 760px) {

    .sidebar {
        width: 270px;
        max-width: 85vw;
        transform: translateX(-100%);
        transition: transform 0.25s ease;
        box-shadow: none;
    }

    .sidebar.open {
        transform: translateX(0);
        box-shadow: 10px 0 40px #0009;
    }

    .main-content {
        margin-left: 0;
        padding: 0 16px 22px;
    }

    .topbar {
        min-height: 72px;
        margin-bottom: 27px;
    }

    .menu-toggle {
        display: block;
    }

    .top-title {
        font-size: 10px;
        letter-spacing: 1px;
    }

    .top-subtitle {
        font-size: 10px;
    }

    .top-status {
        padding: 8px;
        font-size: 9px;
    }

    .welcome {
        align-items: flex-start;
        flex-direction: column;
    }

    .stats-grid {
        grid-template-columns: 1fr;
        gap: 12px;
    }

    .stat-card {
        padding: 18px;
    }

    .stat-icon {
        margin-bottom: 13px;
    }

    .content-card {
        padding: 18px;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .full-width {
        grid-column: auto;
    }

    .tools-grid {
        grid-template-columns: 1fr;
    }

    .footer {
        flex-direction: column;
        line-height: 1.7;
    }
}

/* SMALL PHONES */

@media (max-width: 380px) {

    .main-content {
        padding-left: 11px;
        padding-right: 11px;
    }

    .top-status {
        font-size: 8px;
    }

    .welcome h1 {
        font-size: 25px;
    }

    .content-card {
        padding: 15px;
    }

    .status-row {
        font-size: 11px;
    }
}

/* DESKTOP LARGE SCREENS */

@media (min-width: 1500px) {

    .main-content {
        padding-left: 55px;
        padding-right: 55px;
    }

    .content-card {
        padding: 32px;
    }

    .stats-grid {
        gap: 24px;
    }
}
