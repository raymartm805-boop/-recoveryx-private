* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --navy: #00133f;
    --deep-blue: #002c78;
    --blue: #005bea;
    --electric: #008cff;
    --cyan: #18d9ff;
    --light-blue: #a9eaff;
    --white: #ffffff;
    --text: #062858;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    color: var(--text);
    min-height: 100vh;
    background:
        radial-gradient(ellipse at 85% 15%, #087fe9 0%, transparent 45%),
        radial-gradient(ellipse at 10% 90%, #0064cf 0%, transparent 45%),
        linear-gradient(135deg, #00133f, #003b91 48%, #008bdb);
    background-attachment: fixed;
}

.app-layout {
    display: flex;
    min-height: 100vh;
    background:
        linear-gradient(135deg, #00133fdd, #006bdc44);
}

/* SIDEBAR */

.sidebar {
    width: 270px;
    min-width: 270px;
    padding: 24px 16px;
    display: flex;
    flex-direction: column;
    color: white;
    background:
        radial-gradient(circle at top right, #0879df55, transparent 40%),
        linear-gradient(180deg, #001238, #002d72 65%, #001747);
    border-right: 2px solid #12cfff;
    box-shadow: 5px 0 30px #00aaff55;
}

.brand {
    text-align: center;
    padding: 10px 5px 28px;
}

.brand-icon {
    font-size: 55px;
    filter: drop-shadow(0 0 12px #00cfff);
}

.brand h2 {
    font-size: 27px;
    line-height: 1.2;
    color: white;
}

.brand h2 span {
    color: #28dfff;
}

.brand p {
    margin-top: 12px;
    color: #bdeaff;
    font-size: 13px;
    line-height: 1.6;
}

.side-nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.side-nav a {
    padding: 14px 12px;
    color: #e8f7ff;
    text-decoration: none;
    font-size: 14px;
    border-radius: 12px;
    transition: 0.25s;
}

.side-nav a:hover,
.side-nav a.active {
    background: linear-gradient(100deg, #00baff, #0759ed);
    box-shadow: 0 0 18px #00aaff88;
    color: white;
}

.side-nav h3 {
    color: #19dfff;
    margin: 18px 5px 5px;
    font-size: 15px;
}

.sidebar-footer {
    margin-top: auto;
    padding-top: 30px;
    text-align: center;
    color: #d7f4ff;
    font-size: 12px;
    line-height: 1.8;
}

.footer-shield {
    font-size: 48px;
    filter: drop-shadow(0 0 12px #00dfff);
}

/* MAIN BACKGROUND */

.main-content {
    flex: 1;
    min-width: 0;
    padding: 24px;
    background:
        radial-gradient(ellipse at 90% 10%, #16bfff66, transparent 45%),
        linear-gradient(135deg, #00215caa, #008ee044);
}

/* HEADER */

.topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    padding: 22px 25px;
    margin-bottom: 22px;
    color: white;
    border: 1px solid #29dfff;
    border-radius: 16px;
    background:
        linear-gradient(110deg, #001440, #004eb3, #00a9e9);
    box-shadow: 0 0 24px #008dff66;
}

.topbar h2 {
    font-size: 23px;
}

.topbar h2 span {
    color: #3ce5ff;
}

.topbar p {
    margin-top: 7px;
    font-size: 13px;
    color: #d7f4ff;
}

.online-status {
    padding: 11px 16px;
    border: 1px solid #40dfff;
    border-radius: 30px;
    background: #001b52;
    color: white;
    font-size: 13px;
    white-space: nowrap;
}

.online-status span {
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: 7px;
    border-radius: 50%;
    background: #27ee75;
    box-shadow: 0 0 10px #27ee75;
}

/* DASHBOARD CARDS */

.dashboard-card {
    margin-bottom: 19px;
    padding: 20px;
    overflow: hidden;
    border: 1px solid #72dfff;
    border-radius: 16px;
    background:
        linear-gradient(125deg, #eafaff, #b9eaff 55%, #f4fcff);
    box-shadow:
        0 5px 20px #001d5266,
        0 0 12px #00caff55;
}

.dashboard-card h2 {
    margin: -20px -20px 18px;
    padding: 15px 18px;
    color: white;
    font-size: 19px;
    background:
        linear-gradient(105deg, #001a55, #0068d9 55%, #16c9f4);
    border-bottom: 2px solid #3edfff;
    text-shadow: 0 1px 3px #00133f;
}

.dashboard-card p {
    margin-bottom: 12px;
    font-size: 14px;
    line-height: 1.6;
}

/* BUTTONS */

.button-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
}

.action-button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 45px;
    padding: 13px 20px;
    border: 1px solid #45cfff;
    border-radius: 11px;
    color: white;
    font-size: 14px;
    font-weight: bold;
    text-decoration: none;
    cursor: pointer;
    transition: 0.25s;
    box-shadow: 0 4px 12px #0053b755;
}

.action-button:hover {
    filter: brightness(1.2);
    transform: translateY(-3px);
    box-shadow: 0 0 18px #00bfffaa;
}

.blue {
    background: linear-gradient(110deg, #001e9d, #007fff);
}

.cyan {
    background: linear-gradient(110deg, #00a9df, #7beaff);
    color: #00224f;
}

.facebook {
    background: linear-gradient(110deg, #002d7b, #087bfa);
}

.instagram {
    background: linear-gradient(110deg, #d51ab4, #6426ed);
}

.tiktok {
    background: linear-gradient(110deg, #008edc, #00d5ed);
}

/* SYSTEM STATUS */

.status-content {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 25px;
}

.status-content strong {
    color: #078a31;
    font-size: 21px;
}

/* INPUTS */

.form-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
}

input,
select {
    flex: 1 1 180px;
    min-width: 0;
    padding: 13px;
    border: 1px solid #55adff;
    border-radius: 10px;
    background: #ffffff;
    color: #082c60;
    font-size: 14px;
    outline: none;
    box-shadow: inset 0 1px 4px #006acb18;
}

input:focus,
select:focus {
    border-color: #008cff;
    box-shadow: 0 0 0 3px #008cff33;
}

.form-row button {
    flex: 0 0 auto;
}

.notice {
    margin-top: 13px;
    color: #004eb4;
    font-weight: bold;
}

.demo-note {
    color: #426587;
    font-size: 12px !important;
}

/* RESOURCE BUTTONS */

.resource-buttons {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
}

.resource-buttons a {
    width: 100%;
}

/* FOOTER */

.main-content footer {
    padding: 22px 10px;
    color: #d7f3ff;
    text-align: center;
    font-size: 12px;
    line-height: 1.8;
}

/* TABLET */

@media (max-width: 900px) {
    .sidebar {
        width: 220px;
        min-width: 220px;
    }

    .main-content {
        padding: 15px;
    }

    .resource-buttons {
        grid-template-columns: 1fr;
    }
}

/* MOBILE */

@media (max-width: 600px) {
    .app-layout {
        flex-direction: column;
    }

    .sidebar {
        width: 100%;
        min-width: 0;
        padding: 15px;
    }

    .brand {
        padding-bottom: 15px;
    }

    .side-nav {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
    }

    .side-nav h3 {
        grid-column: 1 / -1;
    }

    .sidebar-footer {
        display: none;
    }

    .main-content {
        padding: 12px;
    }

    .topbar {
        align-items: flex-start;
        flex-direction: column;
    }

    .dashboard-card {
        padding: 15px;
    }

    .dashboard-card h2 {
        margin: -15px -15px 15px;
    }

    .form-row {
        flex-direction: column;
        align-items: stretch;
    }

    .form-row input,
    .form-row select,
    .form-row button {
        width: 100%;
        flex: 1 1 auto;
    }

    .resource-buttons {
        grid-template-columns: 1fr;
    }
}
