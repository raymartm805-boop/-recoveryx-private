
:root {
  --navy: #142b4a;
  --navy-dark: #10233d;
  --blue: #2563eb;
  --blue-hover: #1d4ed8;
  --blue-light: #eff6ff;
  --white: #ffffff;
  --background: #f4f7fb;
  --text: #263449;
  --muted: #8491a3;
  --border: #e5eaf1;
  --green: #16a36a;
  --shadow: 0 8px 28px rgba(20, 43, 74, .06);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Inter, Arial, sans-serif;
  background: var(--background);
  color: var(--text);
  font-size: 14px;
}

button, input, select, textarea {
  font: inherit;
}

button, a {
  -webkit-tap-highlight-color: transparent;
}

a {
  color: var(--blue);
  text-decoration: none;
}

.app-shell {
  display: flex;
  min-height: 100vh;
}

/* SIDEBAR */

.sidebar {
  width: 250px;
  min-height: 100vh;
  background: var(--navy-dark);
  color: white;
  padding: 28px 18px;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 10px 38px;
}

.brand-mark {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: var(--blue);
  display: grid;
  place-items: center;
  font-size: 23px;
  font-weight: 800;
}

.brand-copy strong,
.brand-copy small {
  display: block;
}

.brand-copy strong {
  font-size: 18px;
  letter-spacing: .3px;
}

.brand-copy small {
  color: #a8bad0;
  font-size: 9px;
  letter-spacing: 1.5px;
  margin-top: 4px;
}

.nav-heading {
  color: #8298b2;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.4px;
  padding: 0 12px 13px;
}

.navigation {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.nav-link {
  color: #c3d0df;
  padding: 13px 14px;
  border-radius: 9px;
  font-size: 13px;
  font-weight: 600;
  transition: .2s ease;
}

.nav-link:hover,
.nav-link.active {
  background: #263f60;
  color: white;
}

.nav-link.active {
  box-shadow: inset 3px 0 var(--blue);
}

.sidebar-bottom {
  margin-top: auto;
  padding: 20px 12px 0;
  color: #b8c7d8;
  font-size: 12px;
}

.status-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  background: #2bd18a;
  border-radius: 50%;
  margin-right: 7px;
}

/* MAIN CONTENT */

.main-content {
  flex: 1;
  min-width: 0;
}

.topbar {
  height: 78px;
  background: white;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 35px;
}

.topbar-heading strong,
.topbar-heading small {
  display: block;
}

.topbar-heading strong {
  font-size: 15px;
  color: var(--navy);
}

.topbar-heading small {
  color: var(--muted);
  margin-top: 4px;
  font-size: 11px;
}

.topbar-right {
  display: flex;
  align-items: center;
  gap: 18px;
}

.topbar-status {
  color: var(--green);
  font-size: 12px;
  font-weight: 700;
}

.avatar,
.profile-avatar {
  display: grid;
  place-items: center;
  background: var(--blue-light);
  color: var(--blue);
  font-weight: 800;
  border-radius: 50%;
}

.avatar {
  width: 38px;
  height: 38px;
  cursor: pointer;
}

.menu-toggle {
  display: none;
  background: none;
  border: 0;
  font-size: 23px;
  color: var(--navy);
  cursor: pointer;
}

.page-wrap {
  max-width: 1500px;
  margin: auto;
  padding: 34px;
}

.page-section {
  animation: appear .25s ease;
}

.page-section[hidden] {
  display: none;
}

@keyframes appear {
  from { opacity: 0; transform: translateY(5px); }
  to { opacity: 1; transform: translateY(0); }
}

.page-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin-bottom: 27px;
}

.eyebrow {
  display: block;
  color: var(--blue);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.5px;
  margin-bottom: 8px;
}

.page-heading h1 {
  color: var(--navy);
  font-size: 28px;
  margin-bottom: 7px;
}

.page-heading p {
  color: var(--muted);
  font-size: 13px;
  line-height: 1.6;
}

/* STATISTICS */

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
  margin-bottom: 25px;
}

.stat-card,
.panel,
.resource-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: 13px;
  box-shadow: var(--shadow);
}

.stat-card {
  padding: 23px;
}

.stat-label,
.stat-value,
.stat-note {
  display: block;
}

.stat-label {
  color: #718096;
  font-size: 12px;
  font-weight: 600;
}

.stat-value {
  font-size: 31px;
  color: var(--navy);
  margin: 13px 0 7px;
}

.stat-note {
  color: var(--muted);
  font-size: 11px;
}

/* PANELS */

.content-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: 20px;
}

.panel {
  padding: 24px;
  min-width: 0;
}

.panel h2 {
  color: var(--navy);
  font-size: 16px;
  margin-bottom: 20px;
}

.empty-state {
  color: var(--muted);
  background: #f8fafc;
  padding: 25px;
  border-radius: 9px;
  text-align: center;
  font-size: 12px;
}

.quick-action {
  width: 100%;
  display: block;
  text-align: left;
  border: 1px solid var(--border);
  background: white;
  padding: 14px;
  border-radius: 8px;
  color: var(--text);
  cursor: pointer;
  margin-bottom: 9px;
  transition: .2s;
}

.quick-action:hover {
  border-color: var(--blue);
  background: var(--blue-light);
}

/* BUTTONS */

.button {
  border: 0;
  border-radius: 8px;
  padding: 12px 17px;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: .2s;
}

.button-primary {
  color: white;
  background: var(--blue);
}

.button-primary:hover {
  background: var(--blue-hover);
}

.button-secondary {
  background: #edf1f6;
  color: var(--navy);
}

/* PROFILE */

.profile-panel {
  max-width: 850px;
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 15px;
  border-bottom: 1px solid var(--border);
  padding-bottom: 22px;
  margin-bottom: 23px;
}

.profile-avatar {
  width: 55px;
  height: 55px;
  font-size: 20px;
}

.profile-header h2 {
  margin-bottom: 5px;
}

.profile-header p {
  color: var(--muted);
  font-size: 12px;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 9px;
  color: #46566c;
  font-size: 12px;
  font-weight: 700;
  min-width: 0;
}

.field input,
.field select,
.field textarea,
.toolbar input,
.toolbar select {
  width: 100%;
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 12px;
  outline: none;
  background: white;
  color: var(--text);
  font-size: 13px;
}

.field input:focus,
.field select:focus,
.field textarea:focus,
.toolbar input:focus,
.toolbar select:focus {
  border-color: var(--blue);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, .09);
}

.field textarea {
  resize: vertical;
}

.form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 22px;
}

/* ACCOUNT TABLE */

.toolbar {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr;
  gap: 12px;
  margin-bottom: 22px;
}

.table-wrap {
  width: 100%;
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
  min-width: 620px;
  text-align: left;
}

th {
  background: #f7f9fc;
  color: #718096;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .5px;
}

th, td {
  padding: 15px 13px;
  border-bottom: 1px solid var(--border);
  font-size: 12px;
}

td {
  color: #46566c;
}

.table-empty {
  text-align: center;
  color: var(--muted);
  padding: 30px;
}

/* RESOURCE CARDS */

.tools-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.resource-card {
  padding: 23px;
}

.resource-card h2 {
  font-size: 17px;
  color: var(--navy);
  margin-bottom: 11px;
}

.resource-card p {
  color: var(--muted);
  line-height: 1.7;
  font-size: 12px;
  min-height: 55px;
  margin-bottom: 17px;
}

.resource-card a {
  font-size: 12px;
  font-weight: 700;
}

/* SUPPORT */

.stack-form {
  display: flex;
  flex-direction: column;
  gap: 18px;
  max-width: 650px;
}

.stack-form small {
  color: var(--muted);
  line-height: 1.5;
  font-size: 11px;
}

#supportFeedback,
#profileMessage {
  color: var(--green);
  font-size: 12px;
}

/* SETTINGS */

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 18px 0;
  border-bottom: 1px solid var(--border);
}

.setting-row:last-child {
  border-bottom: 0;
}

.setting-row strong {
  color: var(--navy);
  font-size: 13px;
}

.setting-row p {
  color: var(--muted);
  font-size: 11px;
  margin-top: 5px;
}

.setting-row input {
  width: 18px;
  height: 18px;
  accent-color: var(--blue);
}

/* DIALOG */

dialog {
  width: min(92%, 480px);
  margin: auto;
  padding: 27px;
  border: 1px solid var(--border);
  border-radius: 14px;
  box-shadow: 0 20px 70px rgba(0, 0, 0, .2);
}

dialog::backdrop {
  background: rgba(12, 27, 47, .55);
}

dialog h2 {
  color: var(--navy);
  font-size: 19px;
}

/* FOOTER AND TOAST */

.footer {
  color: var(--muted);
  text-align: center;
  font-size: 11px;
  padding: 35px 0 10px;
}

.toast {
  position: fixed;
  bottom: 25px;
  right: 25px;
  background: var(--navy-dark);
  color: white;
  padding: 13px 19px;
  border-radius: 8px;
  box-shadow: var(--shadow);
  opacity: 0;
  pointer-events: none;
  transform: translateY(10px);
  transition: .25s;
  z-index: 1000;
}

.toast.show {
  opacity: 1;
  transform: translateY(0);
}

/* COMPACT SETTING */

.compact-mode .panel,
.compact-mode .stat-card {
  padding: 16px;
}

.compact-mode .page-wrap {
  padding-top: 23px;
  padding-bottom: 23px;
}

/* TABLET */

@media (max-width: 1000px) {
  .sidebar {
    width: 220px;
  }

  .page-wrap {
    padding: 25px;
  }

  .tools-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* MOBILE */

@media (max-width: 720px) {
  .sidebar {
    position: fixed;
    z-index: 100;
    left: -270px;
    top: 0;
    width: 250px;
    height: 100vh;
    min-height: 100vh;
    transition: left .25s ease;
    box-shadow: 10px 0 30px rgba(0, 0, 0, .12);
  }

  .sidebar.open {
    left: 0;
  }

  .menu-toggle {
    display: block;
    margin-right: 12px;
  }

  .topbar {
    height: 68px;
    justify-content: flex-start;
    padding: 0 17px;
  }

  .topbar-heading {
    flex: 1;
  }

  .topbar-right {
    gap: 10px;
  }

  .topbar-status {
    display: none;
  }

  .page-wrap {
    padding: 23px 16px;
  }

  .page-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .page-heading h1 {
    font-size: 24px;
  }

  .stats-grid {
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .stat-card {
    padding: 18px;
  }

  .stat-value {
    font-size: 26px;
    margin: 8px 0 5px;
  }

  .content-grid,
  .tools-grid,
  .form-grid {
    grid-template-columns: 1fr;
  }

  .toolbar {
    grid-template-columns: 1fr;
  }

  .panel {
    padding: 18px;
  }

  .page-heading .button {
    width: 100%;
  }

  .form-actions {
    flex-wrap: wrap;
  }

  .form-actions .button {
    flex: 1;
  }

  .footer {
    padding-top: 25px;
  }
}
