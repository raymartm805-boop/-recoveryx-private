@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
  --navy: #142b4a;
  --navy-deep: #10233d;
  --blue: #2563eb;
  --blue-hover: #1d4ed8;
  --blue-soft: #eff6ff;
  --page: #f5f8fc;
  --white: #ffffff;
  --text: #1e293b;
  --muted: #64748b;
  --line: #e2e8f0;
  --green: #15803d;
  --amber: #b45309;
  --shadow: 0 8px 24px rgba(15, 23, 42, .045);
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; background: var(--page); color: var(--text); font-size: 14px; }
button, input, select, textarea { font: inherit; }
button, a { -webkit-tap-highlight-color: transparent; }
a { color: inherit; text-decoration: none; }
.app-shell { min-height: 100vh; }
.sidebar {
  width: 258px; position: fixed; inset: 0 auto 0 0; z-index: 30;
  display: flex; flex-direction: column; padding: 27px 17px 18px;
  color: #dce8f8; background: linear-gradient(180deg, var(--navy), var(--navy-deep));
}
.brand { display: flex; align-items: center; gap: 12px; padding: 0 9px 31px; }
.brand-mark { width: 43px; height: 43px; display: grid; place-items: center; border-radius: 12px; background: #fff; color: var(--navy); font-size: 17px; font-weight: 800; letter-spacing: -1px; }
.brand-copy { display: flex; flex-direction: column; gap: 4px; }
.brand-copy strong { color: white; font-size: 15px; letter-spacing: 1.2px; }
.brand-copy strong span { color: #70b5ff; }
.brand-copy small { color: #a9bdd6; font-size: 9px; letter-spacing: 2px; }
.nav-heading { padding: 10px 12px 12px; color: #91a8c5; font-size: 10px; font-weight: 700; letter-spacing: 1.5px; }
.navigation { display: grid; gap: 6px; }
.nav-link { min-height: 46px; display: flex; align-items: center; gap: 13px; padding: 0 13px; border-radius: 9px; color: #c4d2e4; font-size: 13px; font-weight: 500; transition: .18s ease; }
.nav-link:hover { color: #fff; background: rgba(255,255,255,.08); }
.nav-link.active { color: #fff; background: var(--blue); box-shadow: 0 5px 14px rgba(37,99,235,.25); }
.nav-icon { width: 19px; text-align: center; font-size: 18px; }
.sidebar-bottom { display: flex; align-items: center; gap: 9px; margin-top: auto; padding: 17px 12px 5px; color: #a9bdd6; font-size: 9px; font-weight: 700; letter-spacing: 1.2px; }
.status-dot { width: 8px; height: 8px; display: inline-block; flex: 0 0 auto; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 3px rgba(34,197,94,.12); }
.main-content { min-height: 100vh; margin-left: 258px; }
.topbar { height: 76px; position: sticky; top: 0; z-index: 20; display: flex; align-items: center; gap: 16px; padding: 0 34px; background: rgba(255,255,255,.94); border-bottom: 1px solid var(--line); backdrop-filter: blur(12px); }
.topbar-heading { display: flex; flex-direction: column; gap: 5px; }
.topbar-heading strong { color: var(--navy); font-size: 11px; letter-spacing: 1px; }
.topbar-heading span { color: var(--muted); font-size: 11px; }
.topbar-right { display: flex; align-items: center; gap: 10px; margin-left: auto; }
.topbar-status { color: var(--muted); font-size: 9px; font-weight: 700; letter-spacing: .8px; }
.avatar { width: 35px; height: 35px; margin-left: 12px; border: 0; border-radius: 50%; color: #fff; background: var(--blue); font-weight: 700; cursor: pointer; }
.menu-toggle { display: none; border: 0; background: transparent; color: var(--navy); font-size: 23px; cursor: pointer; }
.page-wrap { width: min(1440px, 100%); margin: 0 auto; padding: 34px; }
.page-section[hidden] { display: none !important; }
.page-heading { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 25px; }
.eyebrow { display: block; margin-bottom: 8px; color: var(--blue); font-size: 9px; font-weight: 800; letter-spacing: 1.5px; }
h1, h2, h3, p { margin-top: 0; }
h1 { margin-bottom: 7px; color: var(--navy); font-size: clamp(25px, 3vw, 31px); letter-spacing: -.9px; }
.page-heading p { margin: 0; color: var(--muted); font-size: 12px; }
h2 { margin-bottom: 0; color: var(--navy); font-size: 16px; letter-spacing: -.25px; }
.stats-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 17px; margin-bottom: 20px; }
.stat-card, .panel { background: var(--white); border: 1px solid var(--line); border-radius: 13px; box-shadow: var(--shadow); }
.stat-card { min-height: 145px; padding: 19px; }
.stat-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.stat-icon { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 10px; font-size: 17px; font-weight: 700; }
.stat-icon.blue { color: #2563eb; background: #eff6ff; }
.stat-icon.amber { color: #b45309; background: #fff7ed; }
.stat-icon.green { color: #15803d; background: #f0fdf4; }
.stat-icon.violet { color: #7c3aed; background: #f5f3ff; }
.stat-label { color: var(--muted); font-size: 9px; font-weight: 800; letter-spacing: .8px; text-align: right; }
.stat-value { display: block; margin: 14px 0 4px; color: var(--navy); font-size: 27px; font-weight: 800; letter-spacing: -.8px; }
.stat-online { color: var(--green); font-size: 21px; }
.stat-note { color: #94a3b8; font-size: 10px; }
.content-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(280px, .9fr); gap: 19px; }
.panel { padding: 22px; min-width: 0; }
.panel-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 19px; }
.panel-heading .eyebrow { margin-bottom: 6px; }
.text-link { color: var(--blue); font-size: 11px; font-weight: 700; }
.empty-state { min-height: 185px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.empty-icon { width: 44px; height: 44px; display: grid; place-items: center; margin-bottom: 12px; border-radius: 13px; color: #7b9ac1; background: var(--blue-soft); font-size: 22px; }
.empty-state strong { color: var(--navy); font-size: 12px; }
.empty-state p { margin: 6px 0 0; color: #94a3b8; font-size: 11px; }
.quick-panel { padding-bottom: 10px; }
.quick-action { width: 100%; display: flex; align-items: center; gap: 12px; padding: 12px 0; border: 0; border-top: 1px solid #f1f5f9; background: transparent; text-align: left; cursor: pointer; }
.quick-icon { width: 35px; height: 35px; display: grid; place-items: center; border-radius: 10px; color: var(--blue); background: var(--blue-soft); font-size: 17px; }
.quick-action span:nth-child(2) { display: grid; gap: 4px; flex: 1; }
.quick-action strong { color: var(--text); font-size: 11px; }
.quick-action small { color: var(--muted); font-size: 10px; }
.quick-action b { color: #94a3b8; }
.button { min-height: 40px; display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 0 16px; border: 1px solid transparent; border-radius: 8px; font-size: 11px; font-weight: 700; cursor: pointer; transition: .18s ease; }
.button-primary { color: #fff; background: var(--blue); }
.button-primary:hover { background: var(--blue-hover); transform: translateY(-1px); }
.button-secondary { color: var(--text); background: #fff; border-color: var(--line); }
.form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 17px; }
.profile-panel { max-width: 850px; }
.profile-header { display: flex; align-items: center; gap: 14px; padding-bottom: 22px; margin-bottom: 22px; border-bottom: 1px solid var(--line); }
.profile-header h2 { margin-bottom: 5px; }
.profile-header p { margin: 0; color: var(--muted); font-size: 11px; }
.profile-avatar { width: 54px; height: 54px; display: grid; place-items: center; border-radius: 50%; color: #fff; background: var(--blue); font-size: 21px; font-weight: 800; }
.field { min-width: 0; display: flex; flex-direction: column; gap: 7px; color: #475569; font-size: 10px; font-weight: 700; }
.field input, .field select, .field textarea, .toolbar select, .search-box input { width: 100%; min-height: 41px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 7px; outline: none; color: var(--text); background: #fff; font-size: 11px; font-weight: 400; }
.field textarea { resize: vertical; }
.field input:focus, .field select:focus, .field textarea:focus, .toolbar select:focus, .search-box input:focus { border-color: #80a9fa; box-shadow: 0 0 0 3px rgba(37,99,235,.08); }
.field input:disabled { background: #f8fafc; color: #94a3b8; }
.form-actions { grid-column: 1 / -1; display: flex; align-items: center; gap: 12px; }
.form-message { color: var(--green); font-size: 11px; }
.toolbar { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 17px; }
.search-box { min-width: 220px; flex: 1; position: relative; }
.search-box > span { position: absolute; top: 8px; left: 12px; color: #94a3b8; font-size: 20px; }
.search-box input { padding-left: 36px; }
.toolbar select { width: auto; min-width: 145px; }
.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; white-space: nowrap; }
th { padding: 12px 11px; color: #94a3b8; background: #f8fafc; text-align: left; font-size: 9px; letter-spacing: .6px; }
td { padding: 14px 11px; border-bottom: 1px solid #f1f5f9; color: #475569; font-size: 10px; }
td strong { color: var(--navy); font-size: 11px; }
.table-empty { padding: 35px; color: #94a3b8; text-align: center; }
.status-pill { display: inline-flex; align-items: center; padding: 5px 8px; border-radius: 20px; font-size: 9px; font-weight: 700; }
.status-pending { color: #a16207; background: #fef9c3; }
.status-review { color: #1d4ed8; background: #dbeafe; }
.status-completed { color: #15803d; background: #dcfce7; }
.status-closed { color: #64748b; background: #f1f5f9; }
.table-action { padding: 6px 9px; border: 1px solid var(--line); border-radius: 6px; color: #475569; background: white; font-size: 10px; cursor: pointer; }
.table-action:hover { color: var(--blue); border-color: #bfdbfe; }
.tools-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 15px; }
.resource-card { display: flex; align-items: center; gap: 14px; min-height: 88px; padding: 17px; border: 1px solid var(--line); border-radius: 12px; background: #fff; box-shadow: var(--shadow); transition: .18s ease; }
.resource-card:hover { border-color: #bfdbfe; transform: translateY(-2px); }
.resource-logo { width: 39px; height: 39px; display: grid; place-items: center; border-radius: 11px; color: #fff; font-size: 22px; font-weight: 800; }
.facebook { background: #1877f2; }.instagram { background: #c13584; }.tiktok { background: #111827; }.google { background: #4285f4; }
.resource-card > span:nth-child(2) { display: grid; flex: 1; gap: 5px; }
.resource-card strong { color: var(--navy); font-size: 12px; }
.resource-card small { color: var(--muted); font-size: 10px; }
.resource-card b { color: #94a3b8; }
.stack-form { display: grid; gap: 15px; }
.support-grid { grid-template-columns: minmax(0, 1.1fr) minmax(270px, .9fr); }
.faq { padding: 15px 0; border-top: 1px solid #f1f5f9; }
.faq summary { color: var(--navy); font-size: 11px; font-weight: 700; cursor: pointer; }
.faq p { margin: 10px 0 0; color: var(--muted); font-size: 11px; line-height: 1.7; }
.settings-list { max-width: 900px; }
.setting-row { min-height: 76px; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 15px 0; border-bottom: 1px solid #f1f5f9; }
.setting-row:last-child { border-bottom: 0; }
.setting-row strong { color: var(--navy); font-size: 11px; }
.setting-row p { margin: 5px 0 0; color: var(--muted); font-size: 10px; line-height: 1.5; }
.setting-tag { color: #64748b; font-size: 9px; font-weight: 800; letter-spacing: .6px; }
.switch { position: relative; width: 39px; height: 22px; flex: 0 0 auto; }
.switch input { width: 0; height: 0; opacity: 0; }
.switch span { position: absolute; inset: 0; border-radius: 20px; background: #cbd5e1; cursor: pointer; transition: .2s; }
.switch span:before { content: ""; position: absolute; width: 16px; height: 16px; left: 3px; top: 3px; border-radius: 50%; background: #fff; transition: .2s; }
.switch input:checked + span { background: var(--blue); }
.switch input:checked + span:before { transform: translateX(17px); }
.footer { display: flex; justify-content: space-between; gap: 12px; padding: 28px 2px 5px; color: #94a3b8; font-size: 9px; font-weight: 700; letter-spacing: .8px; }
.modal { width: min(460px, calc(100% - 28px)); padding: 23px; border: 1px solid var(--line); border-radius: 14px; box-shadow: 0 24px 70px rgba(15,23,42,.2); }
.modal::backdrop { background: rgba(15,23,42,.45); backdrop-filter: blur(3px); }
.modal form { display: grid; gap: 14px; }
.modal-heading { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 5px; }
.modal-heading h2 { font-size: 20px; }
.icon-button { width: 30px; height: 30px; border: 0; border-radius: 7px; color: #64748b; background: #f1f5f9; font-size: 21px; cursor: pointer; }
.modal-actions { display: flex; justify-content: flex-end; gap: 9px; margin-top: 5px; }
.field-hint { margin: 0; color: #94a3b8; font-size: 10px; line-height: 1.5; }
.toast { position: fixed; right: 24px; bottom: 24px; z-index: 80; max-width: calc(100% - 48px); padding: 12px 16px; border-radius: 9px; color: #fff; background: var(--navy); box-shadow: var(--shadow); font-size: 11px; opacity: 0; pointer-events: none; transform: translateY(8px); transition: .2s; }
.toast.show { opacity: 1; transform: translateY(0); }
body.compact .stat-card { min-height: 125px; padding: 15px; }
body.compact .panel { padding: 17px; }
@media (max-width: 1100px) {
  .stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .content-grid, .support-grid { grid-template-columns: 1fr; }
}
@media (max-width: 760px) {
  .sidebar { width: 270px; transform: translateX(-100%); transition: transform .25s ease; box-shadow: 12px 0 30px rgba(15,23,42,.15); }
  .sidebar.open { transform: translateX(0); }
  .main-content { margin-left: 0; }
  .menu-toggle { display: block; }
  .topbar { height: 66px; padding: 0 17px; }
  .topbar-heading strong { font-size: 9px; }
  .topbar-heading span { font-size: 10px; }
  .topbar-status { display: none; }
  .page-wrap { padding: 24px 16px; }
  .page-heading { align-items: flex-start; }
  .page-heading .button { padding: 0 11px; font-size: 10px; }
  .stats-grid { gap: 10px; }
  .stat-card { min-height: 133px; padding: 14px; }
  .stat-label { font-size: 8px; }
  .stat-value { font-size: 24px; }
  .tools-grid { grid-template-columns: 1fr; }
  .form-grid { grid-template-columns: 1fr; }
  .form-actions { flex-wrap: wrap; }
  .toolbar select { flex: 1; min-width: 120px; }
  .footer { flex-direction: column; }
}
@media (max-width: 390px) {
  .stats-grid { grid-template-columns: 1fr 1fr; }
  .stat-top { align-items: flex-start; flex-direction: column; }
  .stat-label { text-align: left; }
  .avatar { margin-left: 0; }
}

/* Recent activity rows */
.activity-row { display: flex; align-items: flex-start; gap: 12px; padding: 13px 2px; border-top: 1px solid #f1f5f9; }
.activity-row:first-child { border-top: 0; }
.activity-dot { width: 9px; height: 9px; flex: 0 0 auto; margin-top: 4px; border-radius: 50%; background: #60a5fa; box-shadow: 0 0 0 4px #eff6ff; }
.activity-row strong { display: block; color: var(--navy); font-size: 11px; }
.activity-row p { margin: 5px 0 0; color: var(--muted); font-size: 10px; line-height: 1.5; }
