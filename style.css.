
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --bg: #080c15;
    --card: #1b202c;
    --border: #344653;
    --cyan: #20d8d0;
    --light: #83f4f2;
    --white: #e8f2f8;
}

html {
    scroll-behavior: smooth;
}

body {
    background:
        radial-gradient(circle at 70% 20%, #123b48 0%, transparent 40%),
        linear-gradient(135deg, #030710, #101a29, #07121e);
    color: var(--white);
    font-family: Arial, sans-serif;
    min-height: 100vh;
}

.app {
    display: flex;
    min-height: 100vh;
}

/* SIDEBAR */

.sidebar {
    width: 270px;
    min-width: 270px;
    padding: 25px 20px;
    background: linear-gradient(180deg, #080d18, #111c2b);
    border-right: 1px solid #20d8d044;
    box-shadow: 5px 0 25px #0008;
}

.menu-title {
    color: var(--light);
    font-size: 23px;
    margin: 15px 5px 30px;
    text-shadow: 0 0 12px #20d8d0;
}

.sidebar nav {
    display: flex;
    flex-direction: column;
    gap: 13px;
}

.menu-item {
    display: block;
    text-align: center;
    padding: 19px 12px;
    border-radius: 40px;
    background: linear-gradient(135deg, #202936, #111a26);
    border: 1px solid #40505d;
    color: #c4d6e2;
    font-size: 16px;
    text-decoration: none;
    transition: .25s;
    box-shadow: inset 0 0 10px #0005;
}

.menu-item:hover,
.menu-item.active {
    color: var(--cyan);
    border-color: var(--cyan);
    box-shadow: 0 0 15px #20d8d055;
}

.side-footer {
    margin-top: 65px;
    text-align: center;
    color: #a8bdc9;
    font-size: 12px;
    line-height: 2;
}

.side-footer span {
    font-size: 38px;
}

/* MAIN */

.main-content {
    flex: 1;
    min-width: 0;
    padding: 28px;
    max-width: 1250px;
    margin: auto;
}

.header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 25px;
}

.header h1 {
    color: var(--cyan);
    font-size: 30px;
    text-shadow: 0 0 15px #20d8d077;
}

.header h1 span {
    color: var(--light);
}

.header p {
    color: #91a7b7;
    margin-top: 7px;
    font-size: 12px;
    letter-spacing: 2px;
}

.switch-label {
    color: var(--cyan);
    font-size: 13px;
}

.online-dot,
.result-dot {
    display: inline-block;
    width: 9px;
    height: 9px;
    background: #31e9a0;
    border-radius: 50%;
    box-shadow: 0 0 10px #31e9a0;
    margin-right: 6px;
}

/* PANELS */

.panel {
    background: linear-gradient(145deg, #202633, #171d29);
    border: 1px solid #354b59;
    border-radius: 24px;
    padding: 27px;
    margin-bottom: 24px;
    box-shadow: 0 10px 30px #0007;
}

.panel-title {
    color: var(--cyan);
    font-size: 21px;
    letter-spacing: 1px;
    margin-bottom: 25px;
    text-shadow: 0 0 10px #20d8d044;
}

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
}

input,
select {
    width: 100%;
    min-width: 0;
    padding: 18px;
    background: #141c28;
    border: 1px solid #40515f;
    border-radius: 17px;
    color: white;
    font-size: 16px;
    outline: none;
}

input:focus,
select:focus {
    border-color: var(--cyan);
    box-shadow: 0 0 12px #20d8d044;
}

.field {
    margin-top: 24px;
}

.field label {
    display: block;
    color: var(--light);
    font-size: 12px;
    margin-bottom: 10px;
    letter-spacing: 1px;
}

.submit-btn {
    width: 100%;
    margin-top: 25px;
    padding: 19px;
    background: linear-gradient(110deg, #172532, #263443);
    border: 2px solid #55e4df;
    border-radius: 20px;
    color: var(--cyan);
    font-size: 20px;
    letter-spacing: 2px;
    cursor: pointer;
    box-shadow: 0 0 15px #20d8d033;
    transition: .25s;
}

.submit-btn:hover {
    background: #173c43;
    box-shadow: 0 0 22px #20d8d077;
}

.result {
    margin-top: 25px;
    padding: 15px;
    color: #b9d4df;
    background: #111925;
    border-radius: 12px;
    font-size: 13px;
}

.reference {
    margin-top: 35px;
}

.reference h3 {
    color: white;
    font-size: 23px;
}

.reference p {
    color: #8298a9;
    margin-top: 6px;
    font-size: 12px;
}

/* STATUS */

.status-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 17px 5px;
    border-bottom: 1px solid #344653;
    color: #c4d6e2;
}

.status-row strong {
    color: var(--cyan);
    text-align: right;
    font-size: 12px;
}

/* TOOLS */

.tool-link {
    display: block;
    padding: 17px;
    margin-bottom: 12px;
    border: 1px solid #40515f;
    border-radius: 13px;
    background: #151e2b;
    color: var(--cyan);
    text-decoration: none;
}

.tool-link:hover {
    border-color: var(--cyan);
    box-shadow: 0 0 12px #20d8d044;
}

.description {
    color: #c0d1dd;
    line-height: 1.7;
}

footer {
    text-align: center;
    padding: 25px;
    color: #91a7b7;
    font-size: 12px;
    line-height: 2;
}

/* MOBILE */

@media(max-width: 700px) {
    .app {
        flex-direction: column;
    }

    .sidebar {
        width: 100%;
        min-width: 0;
        padding: 15px;
        border-right: none;
        border-bottom: 1px solid var(--cyan);
    }

    .menu-title {
        margin: 5px 5px 15px;
    }

    .sidebar nav {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 9px;
    }

    .menu-item {
        padding: 14px 7px;
        font-size: 13px;
    }

    .side-footer {
        display: none;
    }

    .main-content {
        padding: 14px;
    }

    .header {
        flex-direction: column;
        align-items: flex-start;
    }

    .header h1 {
        font-size: 25px;
    }

    .panel {
        padding: 18px;
        border-radius: 18px;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .panel-title {
        font-size: 18px;
    }
}
