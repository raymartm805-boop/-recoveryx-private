document.addEventListener("DOMContentLoaded", () => {

    // SYSTEM STATUS
    const status = document.getElementById("systemStatus");
    const button = document.getElementById("checkSystem");

    if (status) {
        status.textContent = "SYSTEM ONLINE";
    }

    if (button) {
        button.addEventListener("click", () => {
            status.textContent = "SYSTEM CHECK COMPLETE";
        });
    }

    // PROFILE URL CHECKER
    const detectionForm = document.getElementById("detectionForm");

    if (detectionForm) {
        detectionForm.addEventListener("submit", (event) => {
            event.preventDefault();

            const url = document.getElementById("profileUrl").value.trim();
            const result = document.getElementById("profileResult");

            try {
                const parsed = new URL(url);
                const domains = [
                    "facebook.com",
                    "www.facebook.com",
                    "instagram.com",
                    "www.instagram.com",
                    "tiktok.com",
                    "www.tiktok.com",
                    "x.com",
                    "www.x.com"
                ];

                if (!domains.includes(parsed.hostname)) {
                    throw new Error("Invalid platform");
                }

                result.hidden = false;

                document.getElementById("platform").textContent = parsed.hostname;
                document.getElementById("username").textContent =
                    parsed.pathname.split("/").filter(Boolean)[0] || "Unknown";

                document.getElementById("profileId").textContent =
                    "Not verified";

                document.getElementById("lookupStatus").textContent =
                    "URL format checked";
            } catch {
                alert("Please enter a valid supported profile URL.");
            }
        });
    }

    // RECOVERY REQUEST FORM
    const recoveryForm = document.getElementById("recoveryForm");

    if (recoveryForm) {
        recoveryForm.addEventListener("submit", (event) => {
            event.preventDefault();
            alert("Form validated. No account credentials were accessed.");
        });
    }

});
