
document.addEventListener("DOMContentLoaded", () => {
  const $ = (id) => document.getElementById(id);

  const STORAGE = {
    profile: "recoveryx_profile",
    accounts: "recoveryx_accounts",
    settings: "recoveryx_settings"
  };

  let accounts = load(STORAGE.accounts, []);
  let profile = load(STORAGE.profile, {});
  let settings = load(STORAGE.settings, {
    compact: false,
    confirmDelete: true
  });

  function load(key, fallback) {
    try {
      const value = JSON.parse(localStorage.getItem(key));
      return value ?? fallback;
    } catch {
      return fallback;
    }
  }

  function save(key, value) {
    localStorage.setItem(key, JSON.stringify(value));
  }

  function escapeHTML(value) {
    return String(value ?? "").replace(/[&<>"']/g, char => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#039;"
    })[char]);
  }

  function toast(message) {
    const element = $("toast");
    if (!element) return;

    element.textContent = message;
    element.classList.add("show");

    clearTimeout(toast.timer);
    toast.timer = setTimeout(() => {
      element.classList.remove("show");
    }, 2500);
  }

  // PAGE NAVIGATION

  const sections = [...document.querySelectorAll(".page-section")];
  const navLinks = [...document.querySelectorAll(".nav-link")];

  function showPage(page) {
    const target = $(page);

    if (!target || !target.classList.contains("page-section")) {
      page = "dashboard";
    }

    sections.forEach(section => {
      section.hidden = section.id !== page;
    });

    navLinks.forEach(link => {
      link.classList.toggle(
        "active",
        link.dataset.page === page
      );
    });

    if (location.hash !== "#" + page) {
      history.replaceState(null, "", "#" + page);
    }

    $("sidebar")?.classList.remove("open");
  }

  navLinks.forEach(link => {
    link.addEventListener("click", event => {
      event.preventDefault();
      showPage(link.dataset.page);
    });
  });

  document.querySelectorAll("[data-go]").forEach(button => {
    button.addEventListener("click", () => {
      showPage(button.dataset.go);
    });
  });

  window.addEventListener("hashchange", () => {
    showPage(location.hash.replace("#", "") || "dashboard");
  });

  showPage(location.hash.replace("#", "") || "dashboard");

  // MOBILE MENU

  $("menuToggle")?.addEventListener("click", () => {
    $("sidebar")?.classList.toggle("open");
  });

  document.addEventListener("click", event => {
    const sidebar = $("sidebar");
    const toggle = $("menuToggle");

    if (
      window.innerWidth <= 720 &&
      sidebar?.classList.contains("open") &&
      !sidebar.contains(event.target) &&
      !toggle?.contains(event.target)
    ) {
      sidebar.classList.remove("open");
    }
  });

  // PROFILE

  function renderProfile() {
    const name = profile.fullName || "User Profile";
    const initial = name.charAt(0).toUpperCase() || "U";

    $("fullName").value = profile.fullName || "";
    $("email").value = profile.email || "";
    $("displayName").value = profile.displayName || "";

    $("profileNameHeading").textContent = name;
    $("profileAvatar").textContent = initial;
    $("profileInitial").textContent = initial;
  }

  $("profileForm")?.addEventListener("submit", event => {
    event.preventDefault();

    profile = {
      fullName: $("fullName").value.trim(),
      email: $("email").value.trim(),
      displayName: $("displayName").value.trim()
    };

    save(STORAGE.profile, profile);
    renderProfile();
    $("profileMessage").textContent = "Profile saved successfully.";
    toast("Profile updated.");
  });

  renderProfile();

  // ACCOUNT RECORDS

  function renderAccounts() {
    const body = $("accountTableBody");
    const search = $("accountSearch").value.toLowerCase();
    const platform = $("platformFilter").value;
    const status = $("statusFilter").value;

    const filtered = accounts.filter(account => {
      const matchesSearch = [
        account.name,
        account.platform,
        account.issue
      ].join(" ").toLowerCase().includes(search);

      const matchesPlatform =
        !platform || account.platform === platform;

      const matchesStatus =
        !status || account.status === status;

      return matchesSearch && matchesPlatform && matchesStatus;
    });

    if (!filtered.length) {
      body.innerHTML = `
        <tr>
          <td colspan="5" class="table-empty">
            No matching records found.
          </td>
        </tr>
      `;
    } else {
      body.innerHTML = filtered.map(account => `
        <tr>
          <td>${escapeHTML(account.name)}</td>
          <td>${escapeHTML(account.platform)}</td>
          <td>${escapeHTML(account.issue)}</td>
          <td>${escapeHTML(account.status)}</td>
          <td>
            <button
              class="button button-secondary delete-record"
              type="button"
              data-id="${escapeHTML(account.id)}">
              Delete
            </button>
          </td>
        </tr>
      `).join("");
    }

    updateDashboard();
  }

  function updateDashboard() {
    $("totalAccounts").textContent = accounts.length;

    $("pendingAccounts").textContent =
      accounts.filter(a => a.status === "Pending").length;

    $("completedAccounts").textContent =
      accounts.filter(a => a.status === "Completed").length;

    const activity = $("recentActivity");

    if (!accounts.length) {
      activity.textContent = "No recent activity.";
    } else {
      activity.innerHTML = accounts
        .slice(-4)
        .reverse()
        .map(account => `
          <p class="activity-item">
            <strong>${escapeHTML(account.name)}</strong>
            — ${escapeHTML(account.status)}
          </p>
        `).join("");
    }
  }

  ["accountSearch", "platformFilter", "statusFilter"].forEach(id => {
    $(id)?.addEventListener("input", renderAccounts);
    $(id)?.addEventListener("change", renderAccounts);
  });

  // ADD RECORD DIALOG

  const dialog = $("accountDialog");

  $("addAccountBtn")?.addEventListener("click", () => {
    dialog.showModal();
  });

  $("cancelDialog")?.addEventListener("click", () => {
    dialog.close();
  });

  $("accountForm")?.addEventListener("submit", event => {
    event.preventDefault();

    const name = $("recordName").value.trim();
    const issue = $("recordIssue").value.trim();

    if (!name || !issue) {
      toast("Please complete the required fields.");
      return;
    }

    const record = {
      id: crypto.randomUUID
        ? crypto.randomUUID()
        : String(Date.now()),
      name,
      platform: $("recordPlatform").value,
      issue,
      status: $("recordStatus").value
    };

    accounts.push(record);
    save(STORAGE.accounts, accounts);

    $("accountForm").reset();
    dialog.close();

    renderAccounts();
    toast("Record saved successfully.");
  });

  // DELETE RECORD

  $("accountTableBody")?.addEventListener("click", event => {
    const button = event.target.closest(".delete-record");
    if (!button) return;

    const id = button.dataset.id;

    if (
      settings.confirmDelete &&
      !window.confirm("Delete this saved record?")
    ) {
      return;
    }

    accounts = accounts.filter(account => account.id !== id);

    save(STORAGE.accounts, accounts);
    renderAccounts();
    toast("Record deleted.");
  });

  // CUSTOMER SUPPORT

  $("supportForm")?.addEventListener("submit", event => {
    event.preventDefault();

    const name = $("supportName").value.trim();
    const email = $("supportEmail").value.trim();
    const message = $("supportMessage").value.trim();

    if (!name || !email || !message) {
      toast("Please complete the form.");
      return;
    }

    $("supportFeedback").textContent =
      "Your request has been prepared on this device. No message was sent.";

    $("supportForm").reset();
  });

  // SETTINGS

  function renderSettings() {
    $("compactToggle").checked = settings.compact;
    $("confirmDeleteToggle").checked = settings.confirmDelete;

    document.body.classList.toggle(
      "compact-mode",
      settings.compact
    );
  }

  $("compactToggle")?.addEventListener("change", event => {
    settings.compact = event.target.checked;
    save(STORAGE.settings, settings);
    renderSettings();
    toast("Layout preference updated.");
  });

  $("confirmDeleteToggle")?.addEventListener("change", event => {
    settings.confirmDelete = event.target.checked;
    save(STORAGE.settings, settings);
    toast("Settings updated.");
  });

  renderSettings();
  renderAccounts();
});
